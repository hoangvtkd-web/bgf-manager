# =============================================================================
#  BGF Manager - Bien moi truong mau
#  Copy file nay thanh `.env.local` roi dien gia tri that.
#  Lay thong tin tai: Supabase Dashboard -> Project Settings -> API
# =============================================================================

# URL project Supabase (dang: https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Anon/public key (an toan de lo ra client, duoc bao ve boi RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# TUY CHON (chi can khi dung Server Actions / API route can quyen cao hon)
# Service role key: CO QUYEN BO QUA RLS - KHONG duoc lo ra trinh duyet!
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
